{
  "components": {
    "schemas": {
      "AgentInfo": {
        "properties": {
          "depends_on": {
            "items": {
              "type": "string"
            },
            "title": "Depends On",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "recommendation_weight": {
            "title": "Recommendation Weight",
            "type": "number"
          }
        },
        "required": [
          "name",
          "description",
          "depends_on",
          "recommendation_weight"
        ],
        "title": "AgentInfo",
        "type": "object"
      },
      "AgentResultOut": {
        "properties": {
          "agent_type": {
            "title": "Agent Type",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          },
          "run_date": {
            "format": "date",
            "title": "Run Date",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "agent_type",
          "symbol",
          "run_date",
          "run_id",
          "updated_at",
          "result"
        ],
        "title": "AgentResultOut",
        "type": "object"
      },
      "AgentRunOut": {
        "properties": {
          "agent_type": {
            "title": "Agent Type",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "format": "date-time",
            "title": "Finished At",
            "type": "string"
          },
          "pipeline_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Run Id"
          },
          "run_date": {
            "format": "date",
            "title": "Run Date",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "skipped",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "pipeline_run_id",
          "agent_type",
          "symbol",
          "run_date",
          "status",
          "error",
          "started_at",
          "finished_at"
        ],
        "title": "AgentRunOut",
        "type": "object"
      },
      "ContributionView": {
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "contribution": {
            "title": "Contribution",
            "type": "number"
          },
          "reasoning": {
            "title": "Reasoning",
            "type": "string"
          },
          "signal": {
            "title": "Signal",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "agent",
          "signal",
          "confidence",
          "weight",
          "contribution",
          "reasoning"
        ],
        "title": "ContributionView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PipelineRunAccepted": {
        "properties": {
          "agents": {
            "items": {
              "type": "string"
            },
            "title": "Agents",
            "type": "array"
          },
          "force": {
            "title": "Force",
            "type": "boolean"
          },
          "pipeline_run_id": {
            "title": "Pipeline Run Id",
            "type": "string"
          },
          "run_date": {
            "format": "date",
            "title": "Run Date",
            "type": "string"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "title": "Symbols",
            "type": "array"
          }
        },
        "required": [
          "pipeline_run_id",
          "run_date",
          "symbols",
          "agents",
          "force"
        ],
        "title": "PipelineRunAccepted",
        "type": "object"
      },
      "PipelineRunRequest": {
        "properties": {
          "agents": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to every agent",
            "title": "Agents"
          },
          "force": {
            "default": false,
            "description": "Re-run agents that already ran today",
            "title": "Force",
            "type": "boolean"
          },
          "symbols": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Defaults to the configured watchlist",
            "title": "Symbols"
          }
        },
        "title": "PipelineRunRequest",
        "type": "object"
      },
      "Recommendation": {
        "properties": {
          "action": {
            "enum": [
              "BUY",
              "SELL",
              "HOLD"
            ],
            "title": "Action",
            "type": "string"
          },
          "agent_breakdown": {
            "items": {
              "$ref": "#/components/schemas/ContributionView"
            },
            "title": "Agent Breakdown",
            "type": "array"
          },
          "agents_available": {
            "title": "Agents Available",
            "type": "integer"
          },
          "agents_missing": {
            "items": {
              "type": "string"
            },
            "title": "Agents Missing",
            "type": "array"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "reasoning": {
            "title": "Reasoning",
            "type": "string"
          },
          "risk_override_applied": {
            "title": "Risk Override Applied",
            "type": "boolean"
          },
          "run_date": {
            "format": "date",
            "title": "Run Date",
            "type": "string"
          },
          "signal": {
            "enum": [
              "bullish",
              "bearish",
              "neutral"
            ],
            "title": "Signal",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "weighted_score": {
            "title": "Weighted Score",
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "run_date",
          "updated_at",
          "action",
          "signal",
          "confidence",
          "weighted_score",
          "reasoning",
          "summary",
          "agents_available",
          "agents_missing",
          "risk_override_applied",
          "agent_breakdown"
        ],
        "title": "Recommendation",
        "type": "object"
      },
      "SymbolOverview": {
        "properties": {
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Recommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "recommendation"
        ],
        "title": "SymbolOverview",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "agentsForStocks",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agents": {
      "get": {
        "operationId": "list_agents_api_v1_agents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentInfo"
                  },
                  "title": "Response List Agents Api V1 Agents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Agents",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/v1/pipeline/runs": {
      "post": {
        "operationId": "start_pipeline_run_api_v1_pipeline_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Pipeline Run",
        "tags": [
          "pipeline"
        ]
      }
    },
    "/api/v1/runs": {
      "get": {
        "operationId": "list_runs_api_v1_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "symbol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Symbol"
            }
          },
          {
            "in": "query",
            "name": "run_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Date"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "completed",
                    "skipped",
                    "failed"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "pipeline_run_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pipeline Run Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentRunOut"
                  },
                  "title": "Response List Runs Api V1 Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Runs",
        "tags": [
          "pipeline"
        ]
      }
    },
    "/api/v1/symbols": {
      "get": {
        "operationId": "list_symbols_api_v1_symbols_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SymbolOverview"
                  },
                  "title": "Response List Symbols Api V1 Symbols Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Symbols",
        "tags": [
          "symbols"
        ]
      }
    },
    "/api/v1/symbols/{symbol}/recommendation": {
      "get": {
        "operationId": "get_recommendation_api_v1_symbols__symbol__recommendation_get",
        "parameters": [
          {
            "description": "Ticker, e.g. AAPL or BRK.B",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "description": "Ticker, e.g. AAPL or BRK.B",
              "title": "Symbol",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Recommendation",
        "tags": [
          "symbols"
        ]
      }
    },
    "/api/v1/symbols/{symbol}/results": {
      "get": {
        "operationId": "list_results_api_v1_symbols__symbol__results_get",
        "parameters": [
          {
            "description": "Ticker, e.g. AAPL or BRK.B",
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "description": "Ticker, e.g. AAPL or BRK.B",
              "title": "Symbol",
              "type": "string"
            }
          },
          {
            "description": "Only this agent's results",
            "in": "query",
            "name": "agent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this agent's results",
              "title": "Agent"
            }
          },
          {
            "description": "Only this market date",
            "in": "query",
            "name": "run_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this market date",
              "title": "Run Date"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentResultOut"
                  },
                  "title": "Response List Results Api V1 Symbols  Symbol  Results Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Results",
        "tags": [
          "symbols"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness + dependencies: 200 when the DB answers and the scheduler runs, else 503.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
