    {
      "type": "table",
      "title": "Run time per agent (completed runs)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agentsforstocks-db"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT agent_type AS \"Agent\", count(*) AS \"Runs\",\n       round(avg(fetch_ms)) AS \"Avg fetch\", round(avg(analyze_ms)) AS \"Avg analyze\",\n       round(percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM finished_at - started_at) * 1000)::numeric) AS \"p95 total\"\nFROM agent_runs WHERE status = 'completed' AND $__timeFilter(started_at)\nGROUP BY 1 ORDER BY \"p95 total\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Runs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "row",
