    {
      "type": "stat",
      "title": "Fallbacks to the quant signal",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agentsforstocks-db"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(llm_fallbacks), 0) AS fallbacks FROM agent_runs WHERE $__timeFilter(started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
