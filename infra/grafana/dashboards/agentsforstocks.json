    {
      "type": "table",
      "title": "Prompt versions in use",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agentsforstocks-db"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "description": "prompt_version is a hash of the system prompt \u2014 a new row means the prompt text changed",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT prompt_name AS \"Prompt\", prompt_version AS \"Version\", min(created_at) AS \"First used\",\n       max(created_at) AS \"Last used\", count(*) AS \"Calls\",\n       round(avg(input_tokens + cache_read_tokens + cache_write_tokens)) AS \"Avg input tokens\"\nFROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1, 3 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
