        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Judgements where Claude was unavailable and the agent kept its own computed signal"
    },
    {
      "type": "table",
      "title": "Per agent",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agentsforstocks-db"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(agent, '(none)') AS \"Agent\",\n       count(*) AS \"Calls\",\n       count(*) FILTER (WHERE status = 'error') AS \"Errors\",\n       sum(input_tokens + cache_read_tokens + cache_write_tokens) AS \"Input tokens\",\n       sum(output_tokens) AS \"Output tokens\",\n       round(avg(input_tokens + cache_read_tokens + cache_write_tokens)) AS \"Avg input / call\",\n       sum(cost_usd) AS \"Cost\",\n       round(avg(latency_ms)) AS \"Avg latency\"\nFROM llm_calls WHERE $__timeFilter(created_at)\nGROUP BY 1 ORDER BY \"Input tokens\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Input tokens"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens by agent",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "agentsforstocks-db"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), coalesce(agent, '(none)') AS metric,\n       sum(input_tokens + cache_read_tokens + cache_write_tokens + output_tokens) AS tokens\nFROM llm_calls WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
