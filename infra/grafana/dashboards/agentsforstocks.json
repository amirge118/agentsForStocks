            "type": "grafana-postgresql-datasource",
            "uid": "agentsforstocks-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(input_tokens + cache_read_tokens + cache_write_tokens + output_tokens), 0) AS tokens FROM llm_calls WHERE $__timeFilter(created_at)"
