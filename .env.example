# Environment: development | test | production (production refuses to start without API_KEYS)
ENVIRONMENT=development
# API keys accepted in the X-API-Key header (comma-separated, >= 32 chars each).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Logging: text (development) or json (one object per line, production)
LOG_FORMAT=text
LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentsforstocks
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentsforstocks

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_DEFAULT_MODEL=claude-haiku-4-5        # per-agent judgements
LLM_REASONING_MODEL=claude-sonnet-4-6     # final recommendation
# Cheapest Claude option — same key, ~10x cheaper than Haiku 4.5 ($0.10 / $0.50 per M tokens).
# Validate with the evals before switching: LLM_DEFAULT_MODEL=claude-haiku-5-5

# --- Free LLM tiers (backend/app/llm/providers_catalog.py) ---
# Each provider joins once its key is set. LLM_PROVIDER=chain sends every call to
# the first provider in LLM_CHAIN with free quota left, then the next, Claude last;
# a free tier that is rate limited or out of daily quota is skipped. Keys (free, no card):
#   Gemini  https://aistudio.google.com/apikey   Groq  https://console.groq.com/keys
#   Cerebras  https://cloud.cerebras.ai
# Check them with: cd backend && python -m scripts.preflight
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
LLM_CHAIN=gemini,groq,cerebras,anthropic:claude-haiku-5-5
# Model / quota overrides, e.g. {"groq": {"model": "qwen/qwen3-32b", "rpd": 900}}
LLM_PROVIDERS=

# --- Optional extra LLM provider (any OpenAI-compatible API) ---
# LLM_PROVIDER picks the default for every agent ("anthropic", "chain", "gemini",
# "groq", "cerebras" or "alt"); AGENT_PROFILES routes single prompts. Examples:
#   Google Gemini (free tier):  LLM_ALT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                               LLM_ALT_MODEL=gemini-flash-lite-latest   (check the current model list)
#   OpenRouter:                 LLM_ALT_BASE_URL=https://openrouter.ai/api/v1
#   Local Ollama ($0):          LLM_ALT_BASE_URL=http://localhost:11434/v1  LLM_ALT_MODEL=qwen3:8b
LLM_PROVIDER=chain        # free tiers first, Claude last (needs at least one key above)
LLM_ALT_BASE_URL=
LLM_ALT_API_KEY=
LLM_ALT_MODEL=
LLM_ALT_INPUT_PRICE=0      # USD per million tokens, for the cost ledger
LLM_ALT_OUTPUT_PRICE=0
# Per-prompt overrides: provider, model, skills, max_tokens, use_llm, prompt (JSON).
# e.g. AGENT_PROFILES={"news_sentiment": {"provider": "alt"}, "technicals": {"use_llm": false}}
AGENT_PROFILES=
AGENT_PROFILES_FILE=
# LLM ledger (llm_calls table): keep the exact prompt + reply of every call for review/evals
LLM_CAPTURE_CONTENT=true
LLM_CALL_RETENTION_DAYS=90

# --- OpenTelemetry (traces, metrics, logs) ---
# true + `docker compose --profile observability up` → Grafana at http://localhost:3001
OTEL_ENABLED=false
# Where to send OTLP/HTTP. In Docker Compose the default is the observability service;
# for a backend running on your machine use http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OpenViking — knowledge/memory layer for agents
OPENVIKING_URL=http://localhost:1933
OPENVIKING_API_KEY=                     # leave blank unless you set root_api_key in ov.conf
OPENVIKING_ENABLED=true                 # set false to disable in tests

# External financial data
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here   # optional fallback
FMP_API_KEY=your_fmp_api_key_here               # required for deep analysis agents (free tier: 250 calls/day)

# Pipeline
# true = run the daily scheduler inside the API process (single process / development).
# Production: RUN_SCHEDULER=false on the API and run `python -m app.worker` once.
RUN_SCHEDULER=true
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,TSLA,META,SPY,QQQ
MAX_CONCURRENT_SYMBOLS=2
MAX_CONCURRENT_AGENTS=4
FMP_DAILY_CALL_LIMIT=250
PROVIDER_CACHE_TTL_SECONDS=21600

# docker compose only (frontend container) — see docker-compose.yml
BACKEND_API_KEY=                        # one of API_KEYS
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
